---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { localize, useTranslations, type Locale } from '../../i18n/ui';
import { href, heroHead, langPaths } from '../../lib/i18n-paths';
import { servers } from '../../content.config';
import { adviceFor, adviceOrder, banners, bestModes, endTime, score, startTime, type Advice, type Banner, type BannerHero } from '../../lib/banners';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const heroes = new Map((await getCollection('heroes')).map((h) => [h.id, h]));
const modes = new Map((await getCollection('modes')).map((m) => [m.id, localize(m.data.name, lang)]));
type Server = (typeof servers)[number];

// Un héros de bannière, avec ce qu'il faut pour l'afficher et le conseil de tirage du serveur.
const resolve = (entry: BannerHero, server: Server) => {
  if (typeof entry !== 'string' && 'name' in entry) {
    return { key: entry.name, name: entry.name, rarity: entry.rarity, cls: entry.class, advice: entry.advice, note: entry.note, ratings: {} as Record<string, string> };
  }
  const id = typeof entry === 'string' ? entry : entry.id;
  const h = heroes.get(id)!;
  const ratings = h.data.tiers[server] ?? {};
  return {
    key: id,
    id,
    name: localize(h.data.name, lang),
    rarity: h.data.rarity ?? '',
    cls: h.data.class,
    gameId: h.data.gameId,
    ratings,
    advice: (typeof entry !== 'string' && entry.advice) || adviceFor(ratings),
    note: typeof entry !== 'string' ? entry.note : undefined,
  };
};
type Resolved = ReturnType<typeof resolve>;
const sortHeroes = (list: Resolved[]) => [...list].sort((a, b) => score(b.advice, b.ratings) - score(a.advice, a.ratings));

const title = (b: Banner) => (b.heroes.length ? b.heroes.slice(0, 3).map((h) => resolve(h, 'global').name).join(' & ') : t('banner.pool.crazy'));
const day = (d: string) => new Date(d + 'T12:00:00Z').toLocaleDateString(lang, { day: 'numeric', month: 'short', timeZone: 'UTC' });
const year = (d: string) => new Date(d + 'T12:00:00Z').getUTCFullYear();
// À date égale, l’ordre du fichier de données est gardé (la bannière la plus importante en premier).
const sorted = [...banners].sort((a, b) => startTime(b) - startTime(a));
// État au moment de la construction ; le script de la page le recalcule à l'ouverture.
const now = Date.now();
const status = (b: Banner) => (now < startTime(b) ? 'soon' : now < endTime(b) ? 'live' : 'past');

// Héros boostés sur toutes les bannières relevées, du plus intéressant au moins intéressant.
const targets = (server: Server) => {
  const seen = new Map<string, { hero: Resolved; count: number; last: string }>();
  for (const b of sorted) {
    for (const entry of b.heroes) {
      const hero = resolve(entry, server);
      const s = seen.get(hero.key);
      if (s) s.count++;
      else seen.set(hero.key, { hero, count: 1, last: b.start });
    }
  }
  return [...seen.values()]
    .filter((s) => s.hero.advice === 'must' || s.hero.advice === 'good')
    .sort((a, b) => score(b.hero.advice, b.hero.ratings) - score(a.hero.advice, a.hero.ratings));
};
const adviceLabel = (a: Advice) => t(`banner.advice.${a}`);
---
<Base lang={lang} title={t('banner.title')} description={t('home.banners')} server>
  <h1>{t('banner.title')}</h1>
  <p class="example">{t('banner.draft')}</p>
  <span data-labels data-live={t('news.live')} data-soon={t('news.soon')} hidden></span>

  <section>
    <h2>{t('banner.now')}</h2>
    <p class="muted" data-empty="live">{t('banner.noneLive')}</p>
    <div class="list" data-list="live"></div>
    <h2>{t('banner.soon')}</h2>
    <p class="muted" data-empty="soon">{t('banner.noneSoon')}</p>
    <div class="list" data-list="soon"></div>
  </section>

  <section>
    <h2>{t('banner.targets')}</h2>
    <p class="muted">{t('banner.targetsNote')}</p>
    {servers.map((server) => (
      <div class="targets" data-server={server}>
        {targets(server).map(({ hero, count, last }) => (
          <a class={`target ${hero.rarity}`} href={hero.id ? href(lang, `heroes/${hero.id}/`) : undefined}>
            {hero.gameId ? <img src={heroHead(hero.gameId)} alt="" width="122" height="185" loading="lazy" /> : <span class="no-img">{hero.name.slice(0, 1)}</span>}
            <span class="target-name">{hero.name}</span>
            <span class={`advice advice-${hero.advice}`}>{adviceLabel(hero.advice)}</span>
            <small class="muted">{t('banner.lastSeen')} {day(last)} {year(last)}{count > 1 && ` · ${count}×`}</small>
          </a>
        ))}
      </div>
    ))}
  </section>

  <details class="past">
    <summary>{t('banner.past')}</summary>
    <div class="list" data-list="past">
      {sorted.map((b) => (
        <article class="banner card" id={b.id} data-start={startTime(b)} data-end={endTime(b)} data-status={status(b)}>
          <header class="banner-head">
            <div>
              <h3>{title(b)}</h3>
              <div class="badges">
                {b.pools.map((p) => <span class="badge">{t(`banner.pool.${p as 'divine' | 'spirits' | 'ancient' | 'choose' | 'shard' | 'crazy'}`)}</span>)}
                {b.rate && <span class="badge legendary">{b.rate}</span>}
              </div>
            </div>
            <div class="when">
              <span class="state" data-state></span>
              <time datetime={b.start}>{day(b.start)}</time> – <time datetime={b.end}>{day(b.end)} {year(b.end)}</time>
            </div>
          </header>
          {b.note && <p class="note">{localize(b.note, lang)}</p>}
          {b.heroes.length > 0 && servers.map((server) => (
            <ul class="picks" data-server={server}>
              {sortHeroes(b.heroes.map((h) => resolve(h, server))).map((hero) => (
                <li class="pick">
                  {hero.gameId ? (
                    <a href={href(lang, `heroes/${hero.id}/`)}><img class={`thumb ${hero.rarity}`} src={heroHead(hero.gameId)} alt="" width="48" height="64" loading="lazy" /></a>
                  ) : (
                    <span class={`thumb no-img ${hero.rarity}`}>{hero.name.slice(0, 1)}</span>
                  )}
                  <div class="pick-body">
                    <div class="pick-line">
                      {hero.id ? <a class="pick-name" href={href(lang, `heroes/${hero.id}/`)}>{hero.name}</a> : <span class="pick-name">{hero.name}</span>}
                      <span class={`advice advice-${hero.advice}`}>{adviceLabel(hero.advice)}</span>
                    </div>
                    <div class="pick-meta muted">
                      <span class={`rar ${hero.rarity}`}>{hero.rarity && t(`rarity.${hero.rarity as 'legendary'}`)}</span> · {t(`class.${hero.cls as 'fighter'}`)}
                      {hero.ratings.campaign && <> · {t('tier.overall')} <span class={`tier tier-${hero.ratings.campaign}`}>{hero.ratings.campaign}</span></>}
                      {bestModes(hero.ratings).filter(([m]) => m !== 'campaign').map(([m, tier]) => <> · {modes.get(m)} <span class={`tier tier-${tier}`}>{tier}</span></>)}
                    </div>
                    {hero.note && <p class="pick-note">{localize(hero.note, lang)}</p>}
                  </div>
                </li>
              ))}
            </ul>
          ))}
          {b.source === 'in-game' ? (
            <span class="source muted">{t('news.source')} · {t('banner.inGame')}</span>
          ) : (
            <a class="source muted" href={b.source} rel="noopener" target="_blank">{t('news.source')} · {new URL(b.source).hostname}</a>
          )}
        </article>
      ))}
    </div>
  </details>

  <section>
    <h2>{t('banner.howTitle')}</h2>
    <dl class="legend">
      {adviceOrder.map((a) => (
        <div><dt><span class={`advice advice-${a}`}>{adviceLabel(a)}</span></dt><dd>{t(`banner.how.${a}`)}</dd></div>
      ))}
    </dl>
    <ul class="tips">
      <li>{t('banner.tip.reset')}</li>
      <li>{t('banner.tip.pools')}</li>
      <li>{t('banner.tip.ancient')}</li>
      <li>{t('banner.tip.server')}</li>
    </ul>
  </section>
</Base>

<style>
  .list { display: grid; gap: 12px; }
  .banner-head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 16px; }
  .banner h3 { margin: 0 0 6px; font: 600 1.1rem var(--heading); color: var(--gold-2); }
  .when { color: var(--muted); font-size: 0.9rem; display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
  .state { font-size: 0.75rem; font-weight: 700; padding: 2px 8px; border-radius: 999px; }
  .state:empty { display: none; }
  [data-status='live'] .state { background: #3fbf6a; color: #06140b; }
  [data-status='soon'] .state { background: var(--gold); color: #1a1406; }
  [data-status='live'] { border-color: color-mix(in srgb, #3fbf6a 55%, var(--border)); }
  .note { margin: 10px 0 0; color: var(--muted); }
  .picks { list-style: none; padding: 0; margin: 12px 0 0; display: grid; gap: 10px; }
  .pick { display: flex; gap: 12px; align-items: flex-start; }
  .pick-body { min-width: 0; flex: 1; }
  .pick-line { display: flex; flex-wrap: wrap; gap: 6px 10px; align-items: center; }
  .pick-name { font-weight: 600; }
  .pick-meta { font-size: 0.82rem; margin-top: 2px; }
  .pick-meta .tier { font-size: 0.75rem; padding: 0 5px; min-width: 0; }
  .pick-note { margin: 4px 0 0; font-size: 0.88rem; }
  .rar.legendary { color: var(--legendary); }
  .rar.epic { color: var(--epic); }
  .rar.rare { color: var(--rare); }
  .thumb { width: 48px; height: 64px; border-radius: 8px; object-fit: cover; object-position: top; border: 2px solid var(--border); flex: none; background: var(--surface-2); }
  .thumb.legendary, .target.legendary img, .target.legendary .no-img { border-color: var(--legendary); }
  .thumb.epic, .target.epic img, .target.epic .no-img { border-color: var(--epic); }
  .thumb.rare, .target.rare img { border-color: var(--rare); }
  .no-img { display: grid; place-items: center; font: 700 1.4rem var(--heading); color: var(--muted); }
  .source { display: inline-block; margin-top: 10px; font-size: 0.8rem; }

  .advice { font-size: 0.72rem; font-weight: 700; padding: 2px 8px; border-radius: 999px; white-space: nowrap; border: 1px solid transparent; }
  .advice-must { background: #ff5d5d; color: #1a0b0b; }
  .advice-good { background: #ff9f43; color: #1a1006; }
  .advice-team { background: #f6d55c; color: #1a1606; }
  .advice-skip { background: var(--surface-2); color: var(--muted); border-color: var(--border); }
  .advice-unrated { background: transparent; color: var(--muted); border-color: var(--border); }

  .targets { display: grid; grid-template-columns: repeat(auto-fill, minmax(104px, 1fr)); gap: 12px; }
  .target { display: flex; flex-direction: column; align-items: center; gap: 4px; text-align: center; color: var(--text); font-size: 0.8rem; min-width: 0; }
  .target img, .target .no-img { width: 100%; height: auto; aspect-ratio: 122 / 185; object-fit: cover; border-radius: 8px; border: 2px solid var(--border); background: var(--surface-2); }
  .target-name { font-weight: 600; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .target small { font-size: 0.7rem; }

  .past { margin-top: 32px; }
  .past summary { cursor: pointer; font: 600 1.1rem var(--heading); color: var(--gold); padding: 8px 0; }
  .past .list { margin-top: 8px; }
  .legend { display: grid; gap: 8px; margin: 0; }
  .legend div { display: grid; grid-template-columns: 9.5rem 1fr; gap: 12px; align-items: baseline; }
  .legend dd { margin: 0; }
  @media (max-width: 520px) { .legend div { grid-template-columns: 1fr; gap: 4px; } }
  .tips { color: var(--muted); padding-left: 1.2em; }
  .tips li { margin: 6px 0; }
</style>

<script>
  // Range chaque bannière (en cours, à venir, passée) selon l'heure du visiteur : le site n'est reconstruit qu'aux mises à jour.
  const labels = document.querySelector<HTMLElement>('[data-labels]')?.dataset ?? {};
  const now = Date.now();
  const lists = Object.fromEntries([...document.querySelectorAll<HTMLElement>('[data-list]')].map((l) => [l.dataset.list!, l]));
  const cards = [...document.querySelectorAll<HTMLElement>('.banner')];
  for (const card of cards) {
    const start = Number(card.dataset.start);
    const end = Number(card.dataset.end);
    const status = now < start ? 'soon' : now < end ? 'live' : 'past';
    card.dataset.status = status;
    card.querySelector('[data-state]')!.textContent = status === 'past' ? '' : (labels[status] ?? '');
    lists[status].append(card);
  }
  // Les bannières à venir s'affichent de la plus proche à la plus lointaine.
  [...lists.soon.children].sort((a, b) => Number((a as HTMLElement).dataset.start) - Number((b as HTMLElement).dataset.start)).forEach((c) => lists.soon.append(c));
  for (const status of ['live', 'soon']) {
    document.querySelector<HTMLElement>(`[data-empty="${status}"]`)!.hidden = lists[status].children.length > 0;
  }
</script>
