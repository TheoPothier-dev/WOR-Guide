---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { localize, useTranslations, type Locale } from '../../i18n/ui';
import { langPaths } from '../../lib/i18n-paths';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const sets = (await getCollection('sets')).sort((a, b) => localize(a.data.name, lang).localeCompare(localize(b.data.name, lang), lang));
---
<Base lang={lang} title={t('sets.title')}>
  <h1>{t('sets.title')}</h1>
  {sets.map((s) => (
    <section>
      <h2>{localize(s.data.name, lang)}</h2>
      <ul>
        {s.data.bonuses.map((b) => <li class="text">{localize(b.description, lang)}</li>)}
      </ul>
    </section>
  ))}
</Base>
