---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { localize, useTranslations, type Locale } from '../../i18n/ui';
import { href, heroHead, langPaths } from '../../lib/i18n-paths';
import Feedback from '../../components/Feedback.astro';
import news from '../../data/news.json';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const heroes = await getCollection('heroes');
const counts = {
  heroes: heroes.length,
  sets: (await getCollection('sets')).length,
  artifacts: (await getCollection('artifacts')).length,
};
const sections = [
  { path: 'heroes/', title: t('nav.heroes'), text: t('home.heroes'), count: counts.heroes },
  { path: 'tier-list/', title: t('nav.tierList'), text: t('home.tier') },
  { path: 'banners/', title: t('nav.banners'), text: t('home.banners') },
  { path: 'sets/', title: t('nav.sets'), text: t('home.sets'), count: counts.sets },
  { path: 'artifacts/', title: t('nav.artifacts'), text: t('home.artifacts'), count: counts.artifacts },
];
// Les actus citent les héros par leur nom anglais, parfois abrégé (« Ezio », « Eivor »).
const findHero = (name: string) => {
  const n = name.toLowerCase();
  return heroes.find((h) => h.data.name.en.toLowerCase() === n) ?? heroes.find((h) => h.data.name.en.toLowerCase().startsWith(n + ' '));
};
const typeLabel = (type: string) => t(`news.${type as 'update' | 'event' | 'hero' | 'collab' | 'code'}`);
const text = (en: string, fr: string) => localize({ en, fr }, lang);
const day = (d: string) => new Date(d + 'T12:00:00Z').toLocaleDateString(lang, { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const updated = day(new Date().toISOString().slice(0, 10));
const short = (d: string) => new Date(d + 'T12:00:00Z').toLocaleDateString(lang, { day: 'numeric', month: 'short', timeZone: 'UTC' });
// Seules les dernières actus sont visibles d'emblée ; le reste s'ouvre à la demande.
const latest = 4;
---
<Base lang={lang}>
  <section class="hero">
    <h1>{t('siteTitle')}</h1>
    <p>{t('home.intro')}</p>
    <button type="button" class="big-search" data-search-open>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2" /><path d="M16.5 16.5L21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      {t('search.placeholder')}
    </button>
  </section>

  <nav class="sections" aria-label={t('home.explore')}>
    {sections.map((s) => (
      <a class="section" href={href(lang, s.path)}>
        <span class="section-title">{s.title}</span>
        {s.count !== undefined && <span class="count">{s.count}</span>}
      </a>
    ))}
  </nav>

  <section class="news">
    <div class="news-head">
      <h2>{t('home.news')}</h2>
      <small class="muted">{t('home.updated')} {updated}</small>
    </div>
    <ol class="news-list">
      {news.map((n, i) => {
        const linked = n.heroes.map(findHero).filter((h) => h !== undefined);
        return (
          <li class={`item type-${n.type}`} data-start={n.date} data-end={n.end ?? ''} hidden={i >= latest}>
            <time datetime={n.date}>{short(n.date)}</time>
            <div class="body">
              <div class="tags">
                <span class="type">{typeLabel(n.type)}</span>
                <span class="state" data-live={t('news.live')} data-soon={t('news.soon')} hidden></span>
                {n.end && <small class="muted">{t('news.until')} {short(n.end)}</small>}
              </div>
              <h3><a href={n.source} rel="noopener" target="_blank">{text(n.title_en, n.title_fr)}</a></h3>
              <p>{text(n.summary_en, n.summary_fr)}</p>
            </div>
            {linked.length > 0 && (
              <span class="faces">
                {linked.slice(0, 3).map((h) => (
                  <a href={href(lang, `heroes/${h.id}/`)} title={localize(h.data.name, lang)}><img src={heroHead(h.data.gameId)} alt={localize(h.data.name, lang)} width="28" height="42" loading="lazy" /></a>
                ))}
              </span>
            )}
          </li>
        );
      })}
    </ol>
    {news.length > latest && <button type="button" class="more" data-more>{t('news.more')} ({news.length})</button>}
    <p class="muted note"><small>{t('news.note')}</small></p>
  </section>

  <Feedback lang={lang} />
</Base>

<style>
  .hero { text-align: center; padding: clamp(28px, 7vw, 72px) 0 clamp(16px, 3vw, 28px); }
  .hero h1 { font-size: clamp(2rem, 6vw, 3.4rem); margin: 0 0 0.3em; }
  .hero p { font-size: 1.1rem; color: var(--muted); max-width: 36em; margin: 0 auto; }
  .big-search {
    display: inline-flex; align-items: center; gap: 10px; margin-top: 24px; width: min(480px, 100%);
    font: inherit; color: var(--muted); cursor: pointer; text-align: left;
    background: var(--surface); border: 1px solid var(--border); border-radius: 999px; padding: 12px 18px;
  }
  .big-search:hover { border-color: var(--gold); color: var(--text); }

  .sections { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin: 8px auto 0; max-width: 720px; }
  .section {
    display: inline-flex; align-items: baseline; gap: 8px; padding: 8px 16px; border-radius: 999px;
    border: 1px solid var(--border); color: var(--text); font-weight: 600; transition: border-color 0.15s, color 0.15s;
  }
  .section:hover { border-color: var(--gold); color: var(--gold-2); }
  .count { color: var(--muted); font-weight: 400; font-size: 0.85rem; }

  .news { max-width: 760px; margin: clamp(36px, 7vw, 64px) auto 0; }
  .news-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; margin-bottom: 4px; }
  .news-head h2 { border: 0; margin: 0; }
  .news-list { list-style: none; margin: 0; padding: 0; }
  .item { display: grid; grid-template-columns: 4.5em 1fr auto; gap: 4px 16px; align-items: start; padding: 18px 0; border-top: 1px solid var(--border); }
  .item:first-child { border-top: 0; }
  .item time { color: var(--muted); font-size: 0.85rem; padding-top: 2px; white-space: nowrap; }
  .tags { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 8px; font-size: 0.8rem; }
  .item h3 { margin: 4px 0 2px; font-size: 1.05rem; line-height: 1.35; }
  .item h3 a { color: var(--text); }
  .item h3 a:hover { color: var(--gold-2); }
  .item p {
    margin: 0; font-size: 0.9rem; color: var(--muted);
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .faces { display: flex; gap: 4px; padding-top: 2px; }
  .faces img { width: 28px; height: 42px; border-radius: 5px; object-fit: cover; border: 1px solid var(--border); }
  .type, .state { font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; font-size: 0.68rem; color: var(--muted); }
  .type::before { content: ''; display: inline-block; width: 7px; height: 7px; border-radius: 50%; margin-right: 6px; background: var(--border); vertical-align: 1px; }
  .type-update .type::before { background: var(--gold); }
  .type-event .type::before { background: #7bd389; }
  .type-hero .type::before { background: var(--legendary); }
  .type-collab .type::before { background: var(--epic); }
  .type-code .type::before { background: var(--rare); }
  .state { padding: 1px 7px; border-radius: 4px; background: rgba(123, 211, 137, 0.15); color: #9fe0aa; }
  .state.soon { background: rgba(79, 157, 255, 0.14); color: #8cc0ff; }
  .more { display: block; margin: 8px auto 0; font: inherit; font-size: 0.9rem; color: var(--gold); background: none; border: 1px solid var(--border); border-radius: 999px; padding: 8px 18px; cursor: pointer; }
  .more:hover { border-color: var(--gold); }
  .note { margin: 18px 0 0; text-align: center; }
  @media (max-width: 560px) {
    .item { grid-template-columns: 1fr auto; }
    .item time { grid-column: 1 / -1; }
  }
</style>

<script>
  // « En cours » / « À venir » selon la date du jour du visiteur, pas celle de la publication du site.
  const today = new Date().toISOString().slice(0, 10);
  for (const item of document.querySelectorAll<HTMLElement>('.news .item')) {
    const { start, end } = item.dataset;
    const state = item.querySelector<HTMLElement>('.state')!;
    const label = start! > today ? 'soon' : end && end >= today ? 'live' : '';
    if (!label) continue;
    state.textContent = state.dataset[label]!;
    state.classList.toggle('soon', label === 'soon');
    state.hidden = false;
  }
  document.querySelector<HTMLButtonElement>('[data-more]')?.addEventListener('click', (e) => {
    document.querySelectorAll<HTMLElement>('.news .item[hidden]').forEach((el) => (el.hidden = false));
    (e.currentTarget as HTMLElement).remove();
  });
</script>
