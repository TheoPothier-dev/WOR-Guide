---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { existsSync } from 'node:fs';
import { asset, heroBust, href } from '../../../lib/i18n-paths';
import { localize, useTranslations, type Locale, type LocalizedText } from '../../../i18n/ui';
import { locales } from '../../../i18n/locales.js';
import { servers } from '../../../content.config';
import statNames from '../../../data/stat-names.json';
import ClassIcon from '../../../components/ClassIcon.astro';

export async function getStaticPaths() {
  const heroes = await getCollection('heroes');
  return locales.flatMap((lang) => heroes.map((hero) => ({ params: { lang, id: hero.id }, props: { hero } })));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const { hero } = Astro.props;
const h = hero.data;
const name = localize(h.name, lang);
const factions = await Promise.all(h.factions.map((f) => getEntry(f)));
const modes = await getCollection('modes');
const artifact = h.exclusiveArtifact ? await getEntry(h.exclusiveArtifact) : undefined;
const stats = h.stats;
// Modèle 3D extrait du jeu, seulement pour les héros qui en ont un dans public/heroes/3d/.
const model = h.gameId && existsSync(`public/heroes/3d/${h.gameId}.glb`) ? asset(`heroes/3d/${h.gameId}.glb`) : undefined;
const mainStats = ['hp', 'atk', 'def', 'mres'] as const;
const statName = (k: string) => localize((statNames as Record<string, LocalizedText>)[k], lang);
// Même calcul que le jeu : interpolation linéaire dans la plage de niveaux de l'étoile, plus le bonus de promotion.
const maxStar = stats?.stars.at(-1);
const statsAt = (s: NonNullable<typeof maxStar>, level: number, promotion: number[]) => {
  const r = (level - s.levelFrom) / (s.levelTo - s.levelFrom);
  return s.base.map((b, i) => Math.floor(b + (s.top[i] - b) * r) + promotion[i]);
};
const maxPromotion = stats ? stats.promotions.length - 1 : 0;
const fixedValue = (k: string, v: number) => {
  if (k === 'interval') return (v * 0.001).toLocaleString(lang) + ' s';
  if (k === 'critDmg') return (v * 0.01).toLocaleString(lang) + ' %';
  return v.toLocaleString(lang);
};
const overall = 'campaign';
const description = [h.title && localize(h.title, lang), t(`class.${h.class}`), h.rarity && t(`rarity.${h.rarity}`)].filter(Boolean).join(' · ');
const setsById = new Map((await getCollection('sets')).map((s) => [s.id, s]));
const artifactsById = new Map((await getCollection('artifacts')).map((a) => [a.id, a]));
const setImage = (gameId: number) => (existsSync(`public/sets/${gameId}_0.webp`) ? asset(`sets/${gameId}_0.webp`) : undefined);
const artifactImage = (gameId: number) => (existsSync(`public/artifacts/${gameId}.webp`) ? asset(`artifacts/${gameId}.webp`) : undefined);
const pct = (n?: number) => (n === undefined ? '' : ` (${n.toLocaleString(lang)} % ${t('hero.usage')})`);
---
<Base lang={lang} title={name} description={`${name} : ${description}`} image={h.gameId ? `heroes/bust/${h.gameId}.webp` : undefined} server>
  <div class="layout">
    <aside class="side">
      <div class={`card identity ${h.rarity ?? ''}`}>
        <img class="bust" src={heroBust(h.gameId)} alt={name} width="296" height="132" />
        <span class="icon" aria-hidden="true"><ClassIcon cls={h.class} size={34} /></span>
        <div>
          {h.title && <p class="title">{localize(h.title, lang)}</p>}
          <h1>{name}</h1>
        </div>
        <div class="badges">
          {h.rarity && <span class={`badge ${h.rarity}`}>{t(`rarity.${h.rarity}`)}</span>}
          <span class="badge"><ClassIcon cls={h.class} size={14} /> {t(`class.${h.class}`)}</span>
          {h.damageType && <span class="badge">{t(`damage.${h.damageType}`)}</span>}
          {factions.map((f) => <span class="badge">{localize(f.data.name, lang)}</span>)}
        </div>
        {overall && servers.map((server) => {
          const tier = h.tiers[server]?.[overall];
          return tier && (
            <a class="overall" href="#tiers" data-server={server}>
              <span class={`tier tier-${tier}`}>{tier}</span> {t('tier.overall')}
            </a>
          );
        })}
        {h.example && <p class="example">{t('data.example')}</p>}
      </div>

      {model && (
        <div class="card model-card">
          <h2>{t('hero.model')}</h2>
          <button type="button" class="show-model" data-model={model}>
            <img src={heroBust(h.gameId)} alt="" width="296" height="132" loading="lazy" />
            <span>▶ {t('hero.modelShow')}</span>
          </button>
          <model-viewer hidden alt={name} camera-controls auto-rotate touch-action="pan-y" exposure="1.4" shadow-intensity="1" camera-orbit="0deg 82deg 4.2m" camera-target="0m 1.05m 0m" field-of-view="30deg" min-camera-orbit="auto auto 1.2m" max-camera-orbit="auto auto 6m" interaction-prompt="none"></model-viewer>
          <p class="note muted" hidden>{t('hero.modelHint')}</p>
        </div>
      )}

      {stats && maxStar && (
        <div class="card stats-card">
          <h2>{t('hero.stats')}</h2>
          <form class="stats-form" data-stats={JSON.stringify(stats)}>
            <label>{t('stats.star')}
              <select name="star">{stats.stars.map((s) => <option value={s.star} selected={s === maxStar}>{s.star}</option>)}</select>
            </label>
            <label>{t('stats.level')}
              <input name="level" type="number" inputmode="numeric" min={Math.max(1, maxStar.levelFrom)} max={maxStar.levelTo} value={maxStar.levelTo} />
            </label>
            <label>{t('stats.promotion')}
              <select name="promotion">{stats.promotions.map((_, i) => <option value={i} selected={i === maxPromotion}>{i}</option>)}</select>
            </label>
          </form>
          <table class="stats">
            <tbody>
              {statsAt(maxStar, maxStar.levelTo, stats.promotions[maxPromotion]).map((v, i) => (
                <tr class="main"><th>{statName(mainStats[i])}</th><td data-stat={i}>{v}</td></tr>
              ))}
              {Object.entries(stats.fixed).map(([k, v]) => (
                <tr><th>{statName(k)}</th><td>{fixedValue(k, v)}</td></tr>
              ))}
            </tbody>
          </table>
          <p class="note muted">{t('stats.note')}</p>
        </div>
      )}
    </aside>

    <div class="content">
      <section>
        <h2>{t('hero.builds')}</h2>
        {servers.map((server) => {
          const builds = h.builds[server] ?? [];
          return (
            <div data-server={server}>
              {builds.length === 0 && <p class="muted">{t('hero.noBuild')}</p>}
              {builds.map((b) => (
                <div class="card build">
                  <header class="build-head">
                    <h3>{localize(b.label, lang)}</h3>
                    <span class={`origin origin-${b.origin}`}>{t(b.origin === 'ai' ? 'build.ai' : 'build.community')}</span>
                  </header>
                  {b.role && <p class="role">{localize(b.role, lang)}</p>}
                  <ul class="items">
                    {b.sets.map((it) => {
                      const set = it.id ? setsById.get(it.id) : undefined;
                      const img = set && setImage(set.data.gameId);
                      return (
                        <li>
                          <a href={set ? `${href(lang, 'sets/')}#${set.id}` : undefined}>
                            {img ? <img src={img} alt="" width="48" height="48" loading="lazy" /> : <span class="ph"></span>}
                            <span><small>{t('hero.gearSets')}{it.pieces ? ` · ${it.pieces}` : ''}</small>{set ? localize(set.data.name, lang) : it.name}{pct(it.usage)}</span>
                          </a>
                        </li>
                      );
                    })}
                    {b.artifacts.map((it) => {
                      const art = it.id ? artifactsById.get(it.id) : undefined;
                      const img = art && artifactImage(art.data.gameId);
                      return (
                        <li>
                          <a href={art ? `${href(lang, 'artifacts/')}#${art.id}` : undefined}>
                            {img ? <img src={img} alt="" width="48" height="48" loading="lazy" /> : <span class="ph"></span>}
                            <span><small>{t('hero.artifacts')}</small>{art ? localize(art.data.name, lang) : it.name}{pct(it.usage)}</span>
                          </a>
                        </li>
                      );
                    })}
                  </ul>
                  {b.notes && <p class="build-note">{localize(b.notes, lang)}</p>}
                  <p class="muted draft"><small>{t(b.origin === 'ai' ? 'build.aiNote' : 'build.draft')}</small></p>
                </div>
              ))}
            </div>
          );
        })}
      </section>

      {h.skills.length > 0 && (
        <section>
          <h2>{t('hero.skills')}</h2>
          <div class="skills">
            {h.skills.map((sk) => (
              <article class="card skill">
                <header>
                  <span class={`kind kind-${sk.kind}`}>{t(`skill.${sk.kind}`)}</span>
                  {sk.cooldown !== undefined && <span class="cd">⏱ {sk.cooldown} {t('skill.seconds')}</span>}
                </header>
                {sk.name.en && <h3>{localize(sk.name as LocalizedText, lang)}</h3>}
                <p class="text">{localize(sk.description, lang)}</p>
              </article>
            ))}
          </div>
        </section>
      )}

      {h.awakenings.length > 0 && (
        <section>
          <h2>{t('hero.awakenings')}</h2>
          <ol class="awakenings">
            {h.awakenings.map((a) => (
              <li class="card">
                <span class="level">{a.level}</span>
                <p class="text">{localize(a.description, lang)}</p>
              </li>
            ))}
          </ol>
        </section>
      )}

      {artifact && (
        <section>
          <h2>{t('hero.exclusiveArtifact')}</h2>
          <div class="card">
            <h3 class="gold">{localize(artifact.data.name, lang)}</h3>
            {artifact.data.description && <p class="text">{localize(artifact.data.description, lang)}</p>}
          </div>
        </section>
      )}

      <section>
        <h2 id="tiers">{t('hero.tiers')}</h2>
        <p class="muted"><small>{t('tier.draft')}</small></p>
        {servers.map((server) => (
          <div class="table-wrap" data-server={server}>
            <table>
              <tbody>
                {modes.map((m) => {
                  const tier = h.tiers[server]?.[m.id];
                  return (
                    <tr>
                      <th>{localize(m.data.name, lang)}</th>
                      <td>{tier ? <span class={`tier tier-${tier}`}>{tier}</span> : <span class="tier-none">{t('tier.notRated')}</span>}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        ))}
      </section>
    </div>
  </div>
</Base>

<style>
  .layout { display: grid; gap: 24px; margin-top: 20px; }
  @media (min-width: 960px) {
    .layout { grid-template-columns: 340px 1fr; align-items: start; }
    .content > section:first-child h2 { margin-top: 0; }
  }
  .side { display: flex; flex-direction: column; gap: 16px; }
  /* Sur téléphone : identité, puis builds et compétences, et seulement après les stats et la 3D. */
  @media (max-width: 959px) {
    .layout { display: flex; flex-direction: column; }
    .side { display: contents; }
    .identity { order: 0; }
    .content { order: 1; }
    .stats-card { order: 2; }
    .model-card { order: 3; }
    .content > section:first-child h2 { margin-top: 0.4em; }
  }
  .identity { overflow: hidden; display: grid; grid-template-columns: auto 1fr; gap: 12px 14px; align-items: center; border-top: 3px solid var(--border); }
  .identity.legendary { border-top-color: var(--legendary); }
  .identity.epic { border-top-color: var(--epic); }
  .identity.rare { border-top-color: var(--rare); }
  .identity.elite { border-top-color: var(--elite); }
  .identity.common { border-top-color: var(--common); }
  .identity h1 { margin: 0; }
  .bust {
    grid-column: 1 / -1; width: calc(100% + 32px); height: auto; margin: -16px -16px 0;
    aspect-ratio: 296 / 132; object-fit: cover; border-radius: var(--radius) var(--radius) 0 0;
    background: radial-gradient(circle at 50% 30%, var(--surface-2), var(--surface));
    -webkit-mask-image: linear-gradient(#000 70%, transparent); mask-image: linear-gradient(#000 70%, transparent);
  }
  .identity .badges, .identity .example { grid-column: 1 / -1; margin: 0; }
  .title { margin: 0; font-style: italic; color: var(--muted); font-size: 0.9rem; }
  .icon {
    width: 56px; height: 56px; border-radius: 50%; display: grid; place-items: center;
    background: var(--surface-2); border: 1px solid var(--gold);
  }
  .overall { grid-column: 1 / -1; display: flex; align-items: center; gap: 10px; color: var(--text); font-weight: 600; }
  .overall .tier { font-size: 1.3rem; padding: 2px 10px; }
  .show-model {
    position: relative; display: block; width: 100%; padding: 0; cursor: pointer; overflow: hidden;
    border: 1px solid var(--border); border-radius: 8px; background: radial-gradient(circle at 50% 40%, var(--surface-2), var(--surface));
  }
  .show-model img { display: block; width: 100%; height: auto; opacity: 0.55; }
  .show-model span {
    position: absolute; inset: 0; display: grid; place-items: center;
    font: 600 1rem var(--heading); color: var(--gold-2); letter-spacing: 0.04em;
  }
  .show-model:hover img { opacity: 0.8; }
  .stats-card h2, .model-card h2 { margin-top: 0; }
  model-viewer { width: 100%; height: 420px; background: radial-gradient(circle at 50% 40%, var(--surface-2), var(--surface)); border-radius: 8px; --poster-color: transparent; }
  .stats-form { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-bottom: 12px; }
  .stats-form label { display: flex; flex-direction: column; gap: 4px; font-size: 0.8rem; color: var(--muted); }
  .stats-form input { width: 100%; }
  .stats th, .stats td { padding: 6px 4px; }
  .stats th { font-weight: 400; color: var(--muted); }
  .stats td { text-align: right; font-variant-numeric: tabular-nums; }
  .stats tr.main td { font-weight: 600; color: var(--gold-2); font-size: 1.05rem; }
  .note { font-size: 0.8rem; margin: 10px 0 0; }
  .skills { display: grid; gap: 12px; }
  .skill header { display: flex; justify-content: space-between; align-items: center; gap: 8px; margin-bottom: 6px; }
  .skill p { margin: 0; color: #d4d0c4; }
  .kind { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; padding: 2px 8px; border-radius: 4px; background: var(--surface-2); color: var(--muted); }
  .kind-ultimate { background: rgba(217, 181, 108, 0.18); color: var(--gold-2); }
  .kind-talent { background: rgba(168, 116, 255, 0.18); color: #c9a6ff; }
  .kind-skill { background: rgba(79, 157, 255, 0.16); color: #8cc0ff; }
  .kind-passive { background: rgba(123, 211, 137, 0.15); color: #9fe0aa; }
  .kind-bond { background: rgba(255, 159, 67, 0.15); color: #ffbf80; }
  .cd { font-size: 0.85rem; color: var(--muted); }
  .awakenings { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .awakenings li { display: flex; gap: 14px; align-items: flex-start; }
  .awakenings p { margin: 0; }
  .level {
    flex: none; width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center;
    font-family: var(--heading); font-weight: 700; background: var(--gold); color: #1a1406;
  }
  .gold { color: var(--gold-2); }
  .build { display: grid; gap: 10px; }
  .build h3 { margin: 0; color: var(--gold-2); }
  .build-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .origin { flex: none; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.04em; padding: 3px 10px; border-radius: 999px; }
  .origin-community { background: rgba(123, 211, 137, 0.15); color: #9fe0aa; border: 1px solid rgba(123, 211, 137, 0.4); }
  .origin-ai { background: rgba(168, 116, 255, 0.16); color: #c9a6ff; border: 1px solid rgba(168, 116, 255, 0.45); }
  .role { margin: -4px 0 0; color: var(--muted); font-size: 0.9rem; }
  .build + .build { margin-top: 12px; }
  .items { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); }
  .items a { display: flex; align-items: center; gap: 10px; color: var(--text); background: var(--surface-2); border: 1px solid var(--border); border-radius: 8px; padding: 6px 10px 6px 6px; height: 100%; }
  .items a[href]:hover { border-color: var(--gold); }
  .items img, .items .ph { width: 48px; height: 48px; flex: none; border-radius: 6px; background: var(--bg); object-fit: contain; }
  .items small { display: block; color: var(--muted); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.05em; }
  .build-note, .draft { margin: 0; color: #d4d0c4; }
  .draft { color: var(--muted); }
</style>

<script>
  // Le lecteur 3D et le modèle (plus d'1 Mo) ne se chargent qu'au clic.
  for (const button of document.querySelectorAll<HTMLButtonElement>('.show-model')) {
    button.addEventListener('click', async () => {
      await import('@google/model-viewer');
      const card = button.parentElement!;
      const viewer = card.querySelector('model-viewer')!;
      viewer.setAttribute('src', button.dataset.model!);
      viewer.hidden = false;
      card.querySelector<HTMLElement>('.note')!.hidden = false;
      button.remove();
    });
  }

  type Stats = {
    stars: { star: number; levelFrom: number; levelTo: number; base: number[]; top: number[] }[];
    promotions: number[][];
  };
  for (const form of document.querySelectorAll<HTMLFormElement>('.stats-form')) {
    const stats: Stats = JSON.parse(form.dataset.stats!);
    const table = form.nextElementSibling!;
    const level = form.elements.namedItem('level') as HTMLInputElement;
    const update = (starChanged: boolean) => {
      const s = stats.stars.find((x) => x.star === Number((form.elements.namedItem('star') as HTMLSelectElement).value))!;
      level.min = String(Math.max(1, s.levelFrom));
      level.max = String(s.levelTo);
      if (starChanged) level.value = String(s.levelTo);
      const lvl = Math.min(s.levelTo, Math.max(Number(level.min), Number(level.value) || s.levelTo));
      const promotion = stats.promotions[Number((form.elements.namedItem('promotion') as HTMLSelectElement).value)];
      const r = (lvl - s.levelFrom) / (s.levelTo - s.levelFrom);
      s.base.forEach((b, i) => {
        table.querySelector(`[data-stat="${i}"]`)!.textContent = String(Math.floor(b + (s.top[i] - b) * r) + promotion[i]);
      });
    };
    form.addEventListener('change', (e) => update((e.target as HTMLElement).getAttribute('name') === 'star'));
    form.addEventListener('input', () => update(false));
  }
</script>
