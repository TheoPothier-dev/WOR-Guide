---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { localize, useTranslations, type Locale } from '../../../i18n/ui';
import { href, langPaths } from '../../../lib/i18n-paths';
import { heroClasses } from '../../../lib/heroes';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const heroes = (await getCollection('heroes')).sort((a, b) => a.data.name.en.localeCompare(b.data.name.en));
---
<Base lang={lang} title={t('heroes.title')}>
  <h1>{t('heroes.title')}</h1>
  {heroClasses.map((cls) => {
    const list = heroes.filter((h) => h.data.class === cls);
    return list.length > 0 && (
      <section>
        <h2>{t(`class.${cls}`)}</h2>
        <ul>
          {list.map((h) => <li><a href={href(lang, `heroes/${h.id}/`)}>{localize(h.data.name, lang)}</a></li>)}
        </ul>
      </section>
    );
  })}
</Base>
