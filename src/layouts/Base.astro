---
import { locales, localeNames } from '../i18n/locales.js';
import { useTranslations, type Locale } from '../i18n/ui';
import { href, switchLang } from '../lib/i18n-paths';
import ServerSwitch from '../components/ServerSwitch.astro';

interface Props {
  lang: Locale;
  title?: string;
}
const { lang, title } = Astro.props;
const t = useTranslations(lang);
import '../styles/global.css';
const path = Astro.url.pathname;
const current = (section: string) => (path.startsWith(href(lang, section)) ? 'page' : undefined);
const pageTitle = title ? `${title} | ${t('siteTitle')}` : t('siteTitle');
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0d1017" />
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700&family=Inter:wght@400;600&display=swap" rel="stylesheet" />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={new URL(switchLang(path, l as Locale), Astro.site)} />)}
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="brand" href={href(lang)}>Watcher of Realms <span>Guide</span></a>
        <nav class="main-nav">
          <a href={href(lang, 'heroes/')} aria-current={current('heroes/')}>{t('nav.heroes')}</a>
          <a href={href(lang, 'tier-list/')} aria-current={current('tier-list/')}>{t('nav.tierList')}</a>
          <a href={href(lang, 'sets/')} aria-current={current('sets/')}>{t('nav.sets')}</a>
          <a href={href(lang, 'artifacts/')} aria-current={current('artifacts/')}>{t('nav.artifacts')}</a>
        </nav>
        <div class="header-tools">
          <ServerSwitch lang={lang} />
          <select aria-label="Language" onchange="location.href = this.value">
            {locales.map((l) => (
              <option value={switchLang(path, l as Locale)} selected={l === lang}>
                {localeNames[l as Locale]}
              </option>
            ))}
          </select>
        </div>
      </div>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">{t('footer.disclaimer')}</div>
    </footer>
  </body>
</html>
